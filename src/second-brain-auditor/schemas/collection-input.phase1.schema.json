{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.second-brain/schemas/collection-input.phase1.schema.json",
  "title": "Second-Brain Auditor Phase 1 Collection Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "run", "active_workflows", "execution_metadata", "privacy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": 1},
    "run": {
      "type": "object",
      "required": ["run_id", "window_start", "window_end", "config_hash", "charter_hash"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "config_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "charter_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "active_workflows": {"type": "array", "items": {"type": "object"}},
    "execution_metadata": {"type": "array", "items": {"type": "object"}},
    "privacy": {
      "type": "object",
      "required": ["active_only_enforced", "credential_values_collected", "execution_payloads_collected"],
      "properties": {
        "active_only_enforced": {"const": true},
        "credential_values_collected": {"const": false},
        "execution_payloads_collected": {"const": false}
      }
    }
  }
}
