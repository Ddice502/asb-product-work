{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.second-brain/schemas/finding.production.schema.json",
  "title": "Production Second-Brain Auditor Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "rule_id",
    "source",
    "severity",
    "confidence",
    "subject",
    "title",
    "charter_alignment",
    "why_it_matters",
    "evidence_refs",
    "manual_instructions",
    "validation_steps",
    "rollback_steps",
    "status",
    "decision_reason",
    "decision_date",
    "review_after"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^[A-Z0-9-]+-[A-F0-9]{12}$"},
    "rule_id": {"type": "string"},
    "source": {"type": "string"},
    "severity": {"enum": ["critical", "warning", "advisory"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subject": {"type": "string"},
    "title": {"type": "string"},
    "charter_alignment": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "manual_instructions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "validation_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "first_detected_at": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "decision_reason": {"type": "string"},
    "decision_date": {"type": "string"},
    "review_after": {"type": "string"},
    "decision_raw": {"type": ["object", "null"]}
  }
}
