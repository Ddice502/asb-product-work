{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.second-brain/schemas/auditor-config.phase1.schema.json",
  "title": "Second-Brain Auditor Phase 1 Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "mode",
    "timezone",
    "schedule_cron",
    "paths",
    "scope",
    "execution_window",
    "limits",
    "thresholds",
    "services",
    "publication"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": 1},
    "mode": {"const": "collection_only"},
    "timezone": {"const": "America/Kentucky/Louisville"},
    "schedule_cron": {"const": "0 4 * * *"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charter", "state_root", "snapshot_root", "log_root", "export_root", "config_root"],
      "properties": {
        "charter": {"const": "/Obsidian/90 System/AI Second Brain Charter.md"},
        "state_root": {"const": "/State/Second Brain/Auditor"},
        "snapshot_root": {"const": "/Archive/Second Brain Auditor/Snapshots"},
        "log_root": {"const": "/Logs/Second Brain Auditor"},
        "export_root": {"const": "/Exports/Second Brain Auditor"},
        "config_root": {"const": "/Config/Second Brain/Auditor"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_metadata_roots", "operational_metadata_roots", "markdown_metadata_roots", "full_content_roots", "safe_plugin_config_roots", "explicit_full_content_files", "exclude_globs"],
      "properties": {
        "tree_metadata_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "operational_metadata_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "markdown_metadata_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "full_content_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "safe_plugin_config_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "explicit_full_content_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "exclude_globs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_lookback_days", "maximum_metadata_records"],
      "properties": {
        "maximum_lookback_days": {"type": "integer", "minimum": 1, "maximum": 10},
        "maximum_metadata_records": {"type": "integer", "minimum": 250, "maximum": 50000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_tree_entries", "maximum_markdown_files", "maximum_markdown_bytes_per_file", "maximum_frontmatter_bytes_per_file", "maximum_full_content_bytes_per_file", "maximum_total_full_content_bytes", "maximum_snapshot_bytes", "lock_stale_after_minutes"],
      "properties": {
        "maximum_tree_entries": {"type": "integer", "minimum": 100, "maximum": 500000},
        "maximum_markdown_files": {"type": "integer", "minimum": 100, "maximum": 250000},
        "maximum_markdown_bytes_per_file": {"type": "integer", "minimum": 65536, "maximum": 33554432},
        "maximum_frontmatter_bytes_per_file": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "maximum_full_content_bytes_per_file": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "maximum_total_full_content_bytes": {"type": "integer", "minimum": 1048576, "maximum": 104857600},
        "maximum_snapshot_bytes": {"type": "integer", "minimum": 1048576, "maximum": 209715200},
        "lock_stale_after_minutes": {"type": "integer", "minimum": 15, "maximum": 1440}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity_warning_percent_remaining", "capacity_critical_percent_remaining", "queue_limits", "stalled_after_minutes"],
      "properties": {
        "capacity_warning_percent_remaining": {"const": 25},
        "capacity_critical_percent_remaining": {"const": 15},
        "queue_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["voice", "documents", "auditor_review"],
          "properties": {
            "voice": {"const": 10},
            "documents": {"const": 15},
            "auditor_review": {"const": 15}
          }
        },
        "stalled_after_minutes": {"const": 90}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_base_url", "ollama_expected_model", "ntfy_base_url", "ntfy_topic"],
      "properties": {
        "ollama_base_url": {"type": "string", "format": "uri"},
        "ollama_expected_model": {"type": "string", "minLength": 1},
        "ntfy_base_url": {"type": "string", "format": "uri"},
        "ntfy_topic": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_findings", "write_obsidian_report", "write_deletion_requests", "write_portable_review_package", "send_success_notification"],
      "properties": {
        "write_findings": {"const": false},
        "write_obsidian_report": {"const": false},
        "write_deletion_requests": {"const": false},
        "write_portable_review_package": {"const": false},
        "send_success_notification": {"const": false}
      }
    }
  }
}
